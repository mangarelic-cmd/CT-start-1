    "E": "E|ID_FROM|EDGE_LABEL|ID_TO, typed conceptual edge",
    "?{X}": "open question for the reader, not a command",
    "A & B": "joint premises",
    "A => B": "scoped if-then under the assumptions of that record; no global proof implied",
    "A != B": "different predicates, claims, or evidence requirements",
    "A -/-> B": "A alone does not establish B",
    "UNKNOWN": "insufficient evidence for stated claim",
    "TRUE@S": "established only in declared scope S",
    "SRC": "I..VIII refer to eight numbered parts of SUMERAI PASS014 English master; III.n to Charter Article n",
    "ENC": "separator | encoded as %7C inside a clause or source; all other Unicode literal"
  },
